{
  "name": "quivers-web",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for Quivers, cathartic jangle pop from Melbourne, Australia.",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "onFail": "error"
    }
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning scripts/dev.ts",
    "build": "node --disable-warning=ExperimentalWarning scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "api-generate": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@stripe/stripe-js": "10.1.0",
    "axios": "1.20.0",
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "orval": "8.43.0",
    "typescript": "6.0.3"
  },
  "resolutions": {
    "orval/@scalar/json-magic/undici": "7.30.1"
  }
}
